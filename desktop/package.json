{
  "name": "sundays",
  "productName": "Sundays",
  "version": "1.45.0",
  "description": "Volunteer workflows and service scheduling, powered by Planning Center.",
  "author": "Wayne Goodman Productions",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs --dist && node dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "koffi": "2.16.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "org.coolchurch.coolservices",
    "productName": "Sundays",
    "copyright": "Wayne Goodman Productions",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "Sundays-${version}-mac.${ext}",
      "x64ArchFiles": "**/app/native/**",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Sundays talks to your Shure receivers, ProPresenter, consoles and iPads on the church network."
      }
    },
    "dmg": {
      "title": "Sundays",
      "artifactName": "Sundays-${version}.dmg"
    },
    "npmRebuild": false,
    "afterSign": "build/after-sign.cjs",
    "asarUnpack": [
      "app/native/**"
    ]
  },
  "sundays": {
    "updateRepo": "creativedamage/sundays"
  },
  "repository": "github:creativedamage/sundays"
}
